{
  "name": "herdplayer",
  "version": "1.1.0",
  "description": "HerdPlayer - Multi-device funscript player",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/handy.test.mjs tests/group-app.test.mjs tests/depletion-clock.test.mjs tests/queue-patterns.test.mjs tests/media-diagnostics.test.mjs tests/runtime-config.test.mjs",
    "icon": "node scripts/generate-icon.js",
    "auth": "node scripts/auth-tools.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.herdplayer.app",
    "productName": "HerdPlayer",
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "files": [
      "main.js",
      "runtime-config.js",
      "preload.js",
      "auth.js",
      "auth-config.js",
      "index.html",
      "video.html",
      "css/**/*",
      "js/**/*"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "HerdPlayer.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.0.0"
  }
}
